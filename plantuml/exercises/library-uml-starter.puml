@startuml
skinparam dpi 150
skinparam classAttributeIconSize 0
hide empty members

' Your task (Chapter 8, Question 1): draw the UML class diagram for the library
' specification — items, books, DVDs, reference-only items, members, librarians,
' and holds.
'
' Define each type as a box, then connect them with the right arrows. One box
' (Item) is filled in as an example — decide on the rest yourself. There is more
' than one defensible answer.
'
' PlantUML cheat-sheet:
'   interface Name { + method() : Type }
'   abstract class Name { # field : Type }
'   class Name { - field : Type }
'   Parent    <|-- Child    ' generalization: Child extends Parent
'   Interface <|.. Class    ' realization:    Class implements Interface
' (Putting the parent/interface on the LEFT of the arrow keeps it on top, which
'  is the convention used in these notes.)

abstract class Item {
  - title : String
  - catalogueNumber : String
  + getTitle() : String
  + getCatalogueNumber() : String
}


class Book {
}

class DVD {
}

abstract class BorrowableItem {
  - borrowLimit : int
  + getBorrowLimit() : int
}

class Librarian {
  - library : Library
  + addItem(item : Item) : boolean
  + waiveFee(memberNumber: int) : boolean
}

class Member {
  - memberNumber: int
  - library : Library
  + getMemberNumber(): int
  + borrowItem(title : String) : boolean
  + borrowItem(catalogueNumber : String) : boolean
  + holdItem(title : String) : boolean
  + holdItem(catalogueNumber : String) : boolean
}


class Library {
  - items : Item[]
  - borrowedItems : Item[]
  - holds : Item[]
  - memberNumbers : int[]
  - fees : int[]
  + getItems(): Item[]
  + getBorrowedItems(): Item[]
  + getHolds(): Item[]
  + getMemberNumbers(): int[]
  + getFees(): int[]
  + addItem(): Item[]
}

Item <|-- BorrowableItem
BorrowableItem <|-- Book
BorrowableItem <|-- DVD
Item <-- Library
Library <-- Member
Library <-- Librarian
Item <-- Librarian
@enduml
